# Excluded from release archives produced by `git archive` (and from
# GitHub's generated release tarballs/zips). CLAUDE.md and test_harness.lua
# are not listed here because they are not tracked at all — see .gitignore.
.gitattributes     export-ignore
.gitignore         export-ignore

# Normalize line endings so the addon doesn't churn between Windows checkouts
# and anything reading it on another platform.
*.lua   text eol=lf
*.md    text eol=lf
